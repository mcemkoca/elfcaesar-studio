{
  "manifest_version": 3,
  "name": "ElfCaesar Parola Köprüsü",
  "short_name": "ElfCaesar",
  "version": "6.10.3",
  "description": "ElfCaesar Studio parola kasasından güvenli otomatik doldurma ve oltalama kalkanı. Parolalar bilgisayarından çıkmaz.",
  "author": "Dante",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ElfCaesar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}